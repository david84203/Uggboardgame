# ---- 既有（桌遊店） ----
# VITE_LIFF_ID=
# VITE_FIREBASE_API_KEY= ...

# ---- AI 妝容診斷（/beauty）前端 ----
VITE_BEAUTY_LIFF_ID=            # Han 的 LINE Login channel 底下建立的 LIFF App ID
VITE_HAN_OA_ID=@726rmfol        # Han 官方帳號 ID（oaMessage、加好友連結用）
# VITE_BEAUTY_DEV_TOKEN=        # 本機開發：與後端 DEV_BYPASS_TOKEN 相同即可跳過 LINE 驗證

# ---- AI 妝容診斷 後端（Vercel Functions） ----
LINE_LOGIN_CHANNEL_ID=          # 驗證 ID Token 用（Han 的 LINE Login channel ID）
FIREBASE_SERVICE_ACCOUNT=       # 整份 service account JSON（單行）
ANTHROPIC_API_KEY=
BEAUTY_AI_PROVIDER=claude       # claude | gemini
BEAUTY_CLAUDE_MODEL=claude-opus-5
# GEMINI_API_KEY=               # 只在 BEAUTY_AI_PROVIDER=gemini 時需要（付費層）
# BEAUTY_GEMINI_MODEL=gemini-2.5-flash
BEAUTY_DAILY_PER_USER=3
BEAUTY_DAILY_GLOBAL=300
# BEAUTY_PRODUCTS_URL=          # 商品對照表 JSON 網址（不設就用 src/beauty/data/products.json）
# DEV_BYPASS_TOKEN=             # 正式環境不要設
